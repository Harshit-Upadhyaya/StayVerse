<% layout("/layouts/boilerplate") %> <!-- to use boilerplate layout -->

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-header">
            <i class="fa-regular fa-compass"></i>
            <h1>Welcome back</h1>
            <p>Log in to your StayVerse account</p>
        </div>

        <form action="/login" method="POST" class="needs-validation" novalidate>

            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input
                    name="username"
                    id="username"
                    type="text"
                    class="form-control"
                    placeholder="Enter your username"
                    required
                />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input
                    name="password"
                    id="password"
                    type="password"
                    class="form-control"
                    placeholder="Enter your password"
                    required
                />
            </div>

            <button class="btn auth-btn w-100">Log in</button>

        </form>

        <div class="auth-footer">
            <span>Don't have an account?</span>
            <a href="/signup">Sign up</a>
        </div>

    </div>
</div>