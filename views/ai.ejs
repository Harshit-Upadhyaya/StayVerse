<% layout("/layouts/boilerplate") %> <!-- to use boilerplate layout -->

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <div class="text-center mb-4">
        <h1>StayVerse AI Assistant</h1>
        <p class="text-muted">
          Ask me anything about travel and finding a stay.
        </p>
      </div>

      <div id="chatBox" class="chat-box mb-3">
        <div class="welcome-message">
          <div class="ai-icon">
            <i class="fa-solid fa-robot"></i>
          </div>
          <h5>Welcome to StayVerse AI</h5>
          <p>
            I can help you with travel ideas, choosing a stay,
            and questions about StayVerse.
          </p>
        </div>
      </div>

      <form id="chatForm">
        <div class="input-group">
          <input
            type="text"
            id="messageInput"
            class="form-control"
            placeholder="Ask something..."
            required
          >

          <button type="submit" class="btn btn-danger">
            Send
          </button>
        </div>
      </form>

    </div>
  </div>
</div>

