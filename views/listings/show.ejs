<% layout("/layouts/boilerplate") %> <!-- to use boilerplate layout -->

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>; 
</script>

<div class="row mt-3">
    <div class="col-12 col-md-8 offset-md-3">
      <h3><%= listing.title %></h3>
    </div>
    <div class="card col-12 col-md-6 offset-md-3 show-card listing-card"> <!--show-card, listing-card class is for custom styling-->
      <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image"> <!--Class show-img is given by us for custom styling-->
      <div class="card-body">
        <p class="card-text"><i>Owned by <b><%= listing.owner.username %></b></i></p>
        <p class="card-text"><%= listing.description %></p>  
        <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-IN") %></p> <!-- &#8377 is for rupee symbol and
        .toLocaleString() fn converts any number into String format with commas, en-IN refers to Indian Standard -->
        <p class="card-text"><i class="fa-solid fa-location-dot" style="color:#fe424d;"></i> <%= listing.location %></p>   
        <p class="card-text"><i class="fa-solid fa-flag" style="color:#fe424d;"></i> <%= listing.country %></p>  
      </div>
    </div>

    <br>
    
    <!-- Show edit and delete buttons only when listing's current user and listing's owner is same-->
    <% if(currUser && currUser._id.equals(listing.owner._id)) { %>  <!-- currUser must exist in locals (res.locals) && currUser id must be equal to listing.owner's id -->
    <div class="btns col-12 col-md-6 offset-md-3">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">Edit</a> <!--edit-btn class is for custom color-->

        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark">Delete</button>
        </form>
    </div>
    <% } %>

    <div class="col-12 col-md-8 offset-md-3 mb-3">
        
        <% if(currUser) { %>
        <hr />
        <h4>Leave a Review</h4>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
          <div class="mb-3 mt-3"> <!--margin-bottom, margin-top 3-->
            <label for="rating" class="form-label">Rating</label> <!--form-label bootstrap class-->
            <fieldset class="starability-slot">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>

          <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Comments</label>
              <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea> <!--form-control bootstrap class-->
              <div class="invalid-feedback">Please add a comment for review</div>
          </div>
          <button class="btn submit-btn">Submit</button>
        </form>
        <hr />
        <% } %>

        <% if(listing.reviews.length > 0) { %> <!-- i.e. if reviews exist in our listing then only display All Reviews section -->
        <!--styling reviews in card form with bootstrap-->
        <div class="row">
          <p><b>All Reviews</b></p>
          <% for(review of listing.reviews) { %>
            <div class="card col-12 col-md-5 mb-3 review-card"> <!--ms is margin-start-->
              <div class="card-body">
                <h5 class="card-title">@<%= review.author.username %></h5>
                <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                <p class="card-text"><%= review.comment %></p>
                
                <% if(currUser && currUser._id.equals(review.author._id)) { %>
                <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button class="btn btn-sm btn-dark">Delete</button>
                </form>
                <% } %>
              </div>
           </div> 
          <% } %>
        </div>
        <% } %>
    </div>
    <div class="col-12 col-md-6 offset-md-3 mb-3">
      <h3>Where you'll be</h3>
      <div id="map"></div>
    </div>

</div>

<!-- Use map.js from public for displaying map-->
<script src="/js/map.js"></script>





